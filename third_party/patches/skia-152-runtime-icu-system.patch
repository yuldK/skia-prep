+std::unique_ptr<SkICULib> SkLoadICULib() {
+    for (const char* path : kLibPaths) {
+        LibHandle handle = open_lib(path);
+        if (!handle) {
+            continue;
+        }
+        if (auto lib = load_from(handle)) {
+            // The handle stays open for the life of the process, as before.
+            return lib;
+        }
+        SkDEBUGF("ICU loader: %s lacks a required symbol.\n", path);
+        close_lib(handle);
+    }
+    SkDEBUGF("ICU loader: no usable system ICU was found.\n");
+    return nullptr;
+}
