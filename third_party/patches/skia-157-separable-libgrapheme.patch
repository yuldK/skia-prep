index a18d081..cedb306 100644
--- a/modules/skshaper/src/SkShaper_skunicode.cpp
+++ b/modules/skshaper/src/SkShaper_skunicode.cpp
@@ -92,11 +92,9 @@ sk_sp<SkUnicode> get_unicode() {
         return unicode;
     }
 #endif  // defined(SK_UNICODE_ICU_IMPLEMENTATION)
-#if defined(SK_UNICODE_LIBGRAPHEME_IMPLEMENTATION)
-    if (auto unicode = SkUnicodes::Libgrapheme::Make()) {
-        return unicode;
-    }
-#endif
+    // skia-prep: libgrapheme is not tried here (skia-157-separable-libgrapheme.patch).
+    // A consumer that links skunicode_libgrapheme gets it through
+    // SkShapers::BestAvailableUnicode().
 #if defined(SK_UNICODE_ICU4X_IMPLEMENTATION)
     if (auto unicode = SkUnicodes::ICU4X::Make()) {
         return unicode;
