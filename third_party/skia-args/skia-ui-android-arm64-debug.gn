target_os = "android"
target_cpu = "arm64"
is_official_build = false
is_debug = true
is_component_build = false

# ndk는 이 기계의 경로라 여기 적지 않는다. clang_win과 같은 규칙으로
# 빌드 스크립트가 이 args 뒤에 덧붙인다. 판번은 Skia CI와 같은 r27d다.
#
# ndk_api가 곧 소비자의 minSdkVersion 하한이다. 26(Android 8.0)은 Vulkan
# backend가 AHardwareBuffer를 쓸 수 있는 첫 판이다.
ndk_api = 26

# Windows 갈래와 같은 계약이다. 소비자도 NDK clang으로 컴파일하므로 어느
# 값이든 성립하지만, 이 값은 sk_sp 같은 형의 호출 규약을 바꾸므로 소비자가
# 따로 맞출 필요가 없는 false로 둔다.
is_trivial_abi = false

# 기본값이 is_clang이라 Android에서는 저절로 켜진다. Windows 갈래와 같은
# 이유로 끈다 — 새 external도, 새 런타임 동작도 들이지 않는다.
skia_use_partition_alloc = false

# 기본값이 is_android다. 켜 두면 perfetto external을 요구한다.
skia_use_perfetto = false

skia_use_vulkan = true
skia_use_gl = false
skia_use_direct3d = false
skia_use_metal = false

# 시스템 폰트를 읽는 길이다. SkFontMgr_android가 /system/etc/fonts.xml을
# expat으로 읽고 글꼴은 freetype이 연다. Windows의 DirectWrite 자리다.
#
# freetype은 컬러 이모지 글리프 때문에 **libpng을 언제나 끌어온다**
# (third_party/freetype2/BUILD.gn). 그래서 rust png 갈래여도 이 대상에는
# libpng과 zlib이 들어간다 — 코덱이 아니라 freetype의 의존으로서다.
skia_use_freetype = true
skia_use_system_freetype2 = false
skia_use_expat = true
skia_use_system_expat = false
skia_use_fontconfig = false
# 그 libpng과 zlib이 기본값(is_official_build)대로 system 라이브러리를
# 찾지 않게 못 박는다. png-libpng.gn도 같은 값을 대입하는데, 같은 값의
# 거듭된 대입은 gn이 받아 준다. png-rust.gn에 두지 않는 것은 Windows가
# 두 라이브러리를 로드하지 않아 "no effect" 경고를 남기기 때문이다.
skia_use_system_libpng = false
skia_use_system_zlib = false

skia_use_harfbuzz = false
skia_use_icu = false
skia_use_icu4x = false
skia_use_libgrapheme = false
skia_use_client_icu = false

# 코덱이다. png만 여기 없다 — png-libpng.gn·png-rust.gn 중 하나를 이 파일 뒤에
# 이어 붙여 정한다. system_* 을 명시하는 이유는 Windows 갈래와 같다 —
# 기본값이 is_official_build이라 Release에서 저절로 켜진다.
skia_use_libjpeg_turbo_decode = true
skia_use_libjpeg_turbo_encode = true
skia_use_system_libjpeg_turbo = false
skia_use_no_jpeg_encode = false
skia_use_libwebp_decode = true
skia_use_libwebp_encode = true
skia_use_system_libwebp = false
skia_use_no_webp_encode = false
skia_use_wuffs = true
skia_use_dng_sdk = false
skia_use_piex = false
skia_use_lua = false
skia_use_jpeg_gainmaps = false
# 기본값이 is_android && ndk_api >= 30이다. ndk_api를 올리면 저절로 켜져
# png·jpeg 디코드가 플랫폼 코덱(AImageDecoder)으로 바뀐다. 코덱을 갈래와
# 무관하게 같게 두려고 끈다.
skia_use_ndk_images = false

skia_enable_pdf = false
skia_enable_svg = false
skia_enable_skottie = false
skia_enable_graphite = false
skia_enable_tools = false
skia_enable_android_utils = false
skia_enable_spirv_validation = false
skia_enable_gpu_debug_layers = false
