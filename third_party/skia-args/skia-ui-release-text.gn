target_cpu = "x64"
target_os = "win"
is_official_build = true
is_component_build = false

# Skia 자신을 무엇으로 컴파일하는가는 build_skia.ps1의 -Toolchain이 정한다
# (clang_win 인자를 이 args 뒤에 덧붙인다). 아래 한 줄은 그 선택과 무관하게
# **언제나 false여야 한다.**
#
# is_trivial_abi = true는 clang에서만 SK_TRIVIAL_ABI=[[clang::trivial_abi]]로
# 펼쳐져 sk_sp 같은 형의 호출 규약을 바꾼다. MSVC로 컴파일되는 소비자에게는
# 그 속성이 없어 같은 형이 서로 다른 ABI가 되고, 링크는 성립한 채 런타임에
# 깨진다. MSVC로 세우던 동안에는 값이 무엇이든 무해했으므로 이 줄이 필요
# 없었다 — clang으로 세우는 지금부터 계약이다 (docs/skia-build.md 5.4).
is_trivial_abi = false

# 기본값이 is_clang이다. 도구사슬을 clang으로 바꾸는 것만으로 저절로 켜져
# third_party/externals/partition_alloc external을 새로 요구하고
# (없으면 gn gen이 거기서 죽는다), Skia 안의 raw_ptr을 noop에서 실물
# 검사 포인터로 바꾼다. 이 저장소가 바꾸려는 것은 컴파일러 하나뿐이므로
# 끈다 — 새 external도, 새 제3자 고지도, 새 런타임 동작도 들이지 않는다.
skia_use_partition_alloc = false

skia_use_direct3d = true
skia_use_gl = false
skia_use_vulkan = false
skia_use_metal = false

skia_use_harfbuzz = true
skia_use_system_harfbuzz = false
skia_use_icu = false
skia_use_system_icu = false
skia_use_icu4x = false
skia_use_libgrapheme = true
skia_use_client_icu = false
skia_use_freetype = false
skia_use_fontconfig = false
skia_use_expat = false

# 코덱이다. png만 여기 없다 — libpng와 rust 중 어느 것으로 세울지는
# png-libpng.gn·png-rust.gn 중 하나를 이 파일 뒤에 이어 붙여 정한다
# (build_skia.ps1의 -RustPng). zlib도 그쪽에 있다: libpng만 zlib을 쓴다.
#
# system_* 을 명시하는 이유는 harfbuzz·icu와 같다 — 기본값이
# is_official_build이라 Release에서 저절로 켜지고 Linux 경로를 참조해 실패한다.
skia_use_libjpeg_turbo_decode = true
skia_use_libjpeg_turbo_encode = true
skia_use_system_libjpeg_turbo = false
skia_use_no_jpeg_encode = false
skia_use_libwebp_decode = true
skia_use_libwebp_encode = true
skia_use_system_libwebp = false
skia_use_no_webp_encode = false
# gif는 wuffs가 디코드한다.
skia_use_wuffs = true
# raw(dng)는 쓰지 않는다. 기본값이
# `skia_use_libjpeg_turbo_decode && skia_use_zlib`이라 jpeg를 켠 지금
# 명시하지 않으면 dng_sdk·piex external이 따라 들어온다.
skia_use_dng_sdk = false
skia_use_piex = false
skia_use_lua = false
# gainmap은 expat(xml)을 끌어온다. 기본값이 is_skia_dev_build라 Debug에서 켜진다.
skia_use_jpeg_gainmaps = false

skia_enable_pdf = false
skia_enable_svg = false
skia_enable_skottie = false
skia_enable_graphite = false
skia_enable_tools = false
skia_enable_android_utils = false
skia_enable_spirv_validation = false
skia_enable_gpu_debug_layers = false

extra_cflags = [ "/MT" ]
